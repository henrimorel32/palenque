# Application
NEXT_PUBLIC_APP_URL=https://votre-hotel.com
NEXT_PUBLIC_API_URL=https://votre-hotel.com/api

# Base de données
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}

# Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Authentification
NEXTAUTH_SECRET=${NEXTAUTH_SECRET}
NEXTAUTH_URL=https://votre-hotel.com

# Stripe (clés de production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}

# Email (SendGrid/AWS SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=${SENDGRID_API_KEY}

# Sécurité
ALLOWED_ORIGINS=https://votre-hotel.com,https://www.votre-hotel.com
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900000

# Monitoring
SENTRY_DSN=${SENTRY_DSN}
LOG_LEVEL=warn