version: '3.8'

services:
  app:
    build:
      context: ./source
      dockerfile: Dockerfile.prod
    container_name: {{ app_name }}-app
    restart: unless-stopped
    expose:
      - "3000"
    environment:
      - NODE_ENV=production
      - NEXT_TELEMETRY_DISABLED=1
      - DB_USER={{ db_user }}
      - DB_PASSWORD={{ db_password }}
      - DB_NAME={{ db_name }}
      - DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@postgres:5432/{{ db_name }}
      - REDIS_PASSWORD={{ redis_password }}
      - REDIS_URL=redis://:{{ redis_password }}@redis:6379
      - NEXTAUTH_SECRET={{ nextauth_secret }}
      - NEXTAUTH_URL=https://{{ domain }}
      - NEXT_PUBLIC_APP_URL=https://{{ domain }}
      - NEXT_PUBLIC_API_URL=https://{{ domain }}/api
    env_file:
      - .env.production
    networks:
      - {{ app_name }}-network
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ traefik_network }}"
      - "traefik.http.routers.{{ app_name }}-app.rule=Host(`{{ domain }}`) || Host(`www.{{ domain }}`)"
      - "traefik.http.routers.{{ app_name }}-app.entrypoints=web"
      - "traefik.http.routers.{{ app_name }}-app.middlewares={{ app_name }}-redirect"
      - "traefik.http.routers.{{ app_name }}-app-secure.rule=Host(`{{ domain }}`) || Host(`www.{{ domain }}`)"
      - "traefik.http.routers.{{ app_name }}-app-secure.entrypoints=websecure"
      - "traefik.http.routers.{{ app_name }}-app-secure.tls=true"
      - "traefik.http.routers.{{ app_name }}-app-secure.tls.certresolver=letsencrypt"
      - "traefik.http.middlewares.{{ app_name }}-redirect.redirectscheme.scheme=https"
      - "traefik.http.services.{{ app_name }}-app.loadbalancer.server.port=3000"

  postgres:
    image: postgres:15-alpine
    container_name: {{ app_name }}-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: {{ db_user }}
      POSTGRES_PASSWORD: {{ db_password }}
      POSTGRES_DB: {{ db_name }}
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./backups:/backups
    networks:
      - {{ app_name }}-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ db_user }} -d {{ db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    container_name: {{ app_name }}-redis
    restart: unless-stopped
    command: redis-server --appendonly yes --requirepass {{ redis_password }}
    volumes:
      - redis_data:/data
    networks:
      - {{ app_name }}-network

  nginx:
    image: nginx:alpine
    container_name: {{ app_name }}-nginx
    restart: unless-stopped
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
      - ./nginx/.htpasswd:/etc/nginx/.htpasswd:ro
      - ./logs/nginx:/var/log/nginx
    depends_on:
      - app
    networks:
      - {{ app_name }}-network
      - {{ traefik_network }}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ traefik_network }}"
      - "traefik.http.routers.{{ app_name }}-nginx.rule=Host(`{{ domain }}`) || Host(`www.{{ domain }}`)"
      - "traefik.http.routers.{{ app_name }}-nginx.entrypoints=web"
      - "traefik.http.routers.{{ app_name }}-nginx.middlewares={{ app_name }}-redirect"
      - "traefik.http.routers.{{ app_name }}-nginx-secure.rule=Host(`{{ domain }}`) || Host(`www.{{ domain }}`)"
      - "traefik.http.routers.{{ app_name }}-nginx-secure.entrypoints=websecure"
      - "traefik.http.routers.{{ app_name }}-nginx-secure.tls=true"
      - "traefik.http.routers.{{ app_name }}-nginx-secure.tls.certresolver=letsencrypt"
      - "traefik.http.middlewares.{{ app_name }}-redirect.redirectscheme.scheme=https"
      - "traefik.http.services.{{ app_name }}-nginx.loadbalancer.server.port=80"

  backup:
    image: postgres:15-alpine
    container_name: {{ app_name }}-backup
    restart: unless-stopped
    environment:
      POSTGRES_USER: {{ db_user }}
      POSTGRES_PASSWORD: {{ db_password }}
      POSTGRES_DB: {{ db_name }}
      PGPASSWORD: {{ db_password }}
    volumes:
      - postgres_data:/data:ro
      - ./backups:/backups
    command: >
      sh -c "
        while true; do
          pg_dump -h postgres -U {{ db_user }} {{ db_name }} > /backups/backup_$$(date +%Y%m%d_%H%M%S).sql
          find /backups -name 'backup_*.sql' -mtime +7 -delete
          sleep 86400
        done
      "
    networks:
      - {{ app_name }}-network

volumes:
  postgres_data:
  redis_data:

networks:
  {{ app_name }}-network:
    driver: bridge
  {{ traefik_network }}:
    external: true
