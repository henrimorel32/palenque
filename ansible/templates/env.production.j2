# ==========================================
# Configuration Production - Palenque
# Domaine : {{ domain }}
# ==========================================

# Base de données (généré automatiquement)
DB_USER={{ db_user | default('palenque_user') }}
DB_PASSWORD={{ db_password | default('Jp4k8Wq2Nz7rTx5mLc9vHd3sBy6fRu1a') }}
DB_NAME={{ db_name | default('palenque_db') }}
DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@postgres:5432/{{ db_name }}

# Redis
REDIS_PASSWORD={{ redis_password }}
REDIS_URL=redis://:{{ redis_password }}@redis:6379

# Application
NEXT_PUBLIC_APP_URL=https://{{ domain }}
NEXT_PUBLIC_API_URL=https://{{ domain }}/api
NODE_ENV=production
PORT=3000

# Authentification
NEXTAUTH_SECRET={{ nextauth_secret }}
NEXTAUTH_URL=https://{{ domain }}

# Stripe (à configurer)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (à configurer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sécurité
ALLOWED_ORIGINS=https://{{ domain }},https://www.{{ domain }}
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900000

# Monitoring
SENTRY_DSN=

# Next.js
NEXT_TELEMETRY_DISABLED=1

