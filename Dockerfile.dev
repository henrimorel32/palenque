# Development - Hot reload enabled
FROM node:20-alpine

WORKDIR /app

# Installation des dépendances système pour dev
RUN apk add --no-cache libc6-compat

# Copie des fichiers de dépendances
COPY package*.json ./

# Installation en mode dev (avec devDependencies)
RUN npm install

# Exposition du port Next.js dev
EXPOSE 3002

# Commande de développement avec hot reload
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

CMD ["npm", "run", "dev"]